# AWS Configuration
AWS_ACCESS_KEY_ID=SUA_ACCESS_KEY_AQUI
AWS_SECRET_ACCESS_KEY=SUA_SECRET_KEY_AQUI
AWS_REGION=us-east-1
S3_BUCKET=s3://nome-do-seu-bucket/backups

# Database Configuration
CONTAINER_BANCO=bd_producao
DOCKER_VOLUME_BD=dados_postgres
DB_USER=admin_usuario
POSTGRES_PASSWORD=senha_segura
POSTGRES_DB=nome_do_banco
POSTGRES_IMAGE=postgres:16

# GitHub Configuration
GITHUB_USER=Matheus-Sleutjes
GITHUB_TOKEN=github_pat_...

# Paths and Logging
PASTA_PROJETO=/app
PASTA_SCRIPTS=/home/ubuntu/scripts
DEPLOY_LOG=/var/log/deploy.log
BACKUP_LOG=/var/log/backup_banco.log
RESTORE_LOG=/var/log/restore_banco.log
VM_INIT_LOG=/var/log/vm_init.log

# VM and Network Configuration
RETENCAO_DIAS=7
COMPOSE_DIR=/app/infra
DOCKER_NETWORK=minha-rede
NOME_CLIENTE_VPN=dev-cliente
CLIENTE_SENHA_VPN=12345678
